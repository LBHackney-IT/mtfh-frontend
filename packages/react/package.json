{
  "name": "@hackney/mtfh-react",
  "version": "1.3.0",
  "description": "LBH React Design System for LBH Modern Tools for Housing",
  "author": "https://hackney.gov.uk/",
  "homepage": "https://github.com/LBHackney-IT/mtfh-frontend",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./reset.css": "./dist/reset.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBHackney-IT/mtfh-frontend.git",
    "directory": "packages/react"
  },
  "scripts": {
    "test": "jest --passWithNoTests --runInBand",
    "test:ci": "jest --runInBand",
    "lint": "eslint src --ext js,jsx,ts,tsx",
    "build": "concurrently \"npm run build:js\" \"npm run build:types\"",
    "build:js": "rollup -c",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "bugs": {
    "url": "https://github.com/LBHackney-IT/mtfh-frontend/issues"
  },
  "devDependencies": {
    "@hackney/eslint-config": "^1.1.1",
    "@hackney/mtfh-test-utils": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "globby": "^12.0.2",
    "history": "^4.10.0",
    "msw": "^2.6.0",
    "postcss": "^8.4.49",
    "postcss-import": "^14.0.2",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "rollup": "^2.52.8",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.0",
    "sass": "^1.81.0",
    "swr": "1.0.1"
  },
  "dependencies": {
    "@hackney/mtfh-system": "^1.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "classnames": "^2.3.1",
    "formik": "^2.4.6",
    "generic-names": "^3.0.0",
    "govuk-frontend": "^3.15.0",
    "lbh-frontend": "4.1.0",
    "react-merge-refs": "^1.1.0",
    "react-router-dom": "^5.2.0",
    "use-breakpoint": "^2.0.1"
  },
  "peerDependencies": {
    "formik": "^2.2.9",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-router-dom": "^5.2.0"
  }
}
