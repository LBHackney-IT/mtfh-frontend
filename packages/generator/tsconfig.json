{
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/templates"],
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "lib": ["es2017"],
    "moduleResolution": "bundler",
    "types": ["node"],
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "generators/types",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
