{
  "name": "mtfh-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pkg": "manypkg run",
    "check:pkgs": "manypkg check",
    "fix:pkgs": "manypkg fix",
    "publish:packages": "lerna publish from-package --yes",
    "test": "lerna run test --stream --concurrency=1",
    "test:ci": "lerna run test:ci --stream --concurrency=1",
    "lint": "lerna run lint --no-private --stream",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "prepare": "husky install && node scripts/link-react-deps.js",
    "build": "lerna run build --no-private --stream"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LBHackney-IT/mtfh-frontend.git"
  },
  "dependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@manypkg/cli": "^0.21.4",
    "babel-jest": "^29.7.0",
    "identity-obj-proxy": "^3.0.0",
    "lerna": "^8.1.9",
    "ts-jest": "^29.2.5",
    "typescript": "~5.6.3",
    "webpack": "^5.97.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@rollup/plugin-commonjs": "^26.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/react-webpack5": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-testing-library": "^6.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.81.0",
    "sass-loader": "^16.0.3",
    "storybook": "^8.4.7",
    "style-loader": "^4.0.0",
    "tslib": "^2.8.1",
    "undici": "^6.21.0"
  },
  "overrides": {
    "is-plain-object": "^3.0.1",
    "ajv": "^8.17.1",
    "ajv-keywords": {
      "ajv": "^8.17.1"
    }
  }
}
